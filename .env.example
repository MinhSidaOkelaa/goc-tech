# Sao chép file này thành .env rồi điền giá trị. KHÔNG đưa .env lên Git, không dán khóa vào chat.
# Để trống biến nào thì dịch vụ đó chạy giả lập và giao diện ghi nhãn "Giả lập".

# --- OpenAI: tư vấn sản phẩm (Responses API). Chỉ backend đọc.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Cloudflare Turnstile: Site Key là mã công khai (frontend), Secret Key chỉ backend đọc.
TURNSTILE_SITE_KEY=0x4AAAAAAF-ene8WE7QFeqYQ
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost

# --- Stripe Sandbox (tùy chọn): chỉ nhận khóa sk_test_… Webhook secret lấy từ `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Chiến dịch Sale Gia Dụng 30% (giờ Việt Nam). Để trống: bắt đầu ngay, kết thúc sau 7 ngày.
SALE_GIA_DUNG_START=
SALE_GIA_DUNG_END=

# --- Ứng dụng
# File SQLite giữ đơn, lần thanh toán, sự kiện webhook và tác vụ qua các lần khởi động (mặc định goctech.db cạnh app.py)
DB_PATH=
PORT=8000
APP_BASE_URL=http://localhost:8000
# Email các tài khoản được vào /admin (cách nhau bằng dấu phẩy)
ADMIN_EMAILS=admin@goctech.example
# Nếu điền, trang đăng nhập admin sẽ hỏi thêm mã này
ADMIN_PASSCODE=

# Sau bao nhiêu giây thì kiểm tra lại một lượt giữ hàng (mặc định 1800).
STOCK_HOLD_S=
